{
  "name": "Group",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u06af\u0631\u0648\u0647"
    },
    "description": {
      "type": "string",
      "title": "\u062a\u0648\u0636\u06cc\u062d\u0627\u062a \u06af\u0631\u0648\u0647"
    },
    "tags": {
      "type": "string",
      "title": "\u062a\u06af \u06af\u0631\u0648\u0647"
    },
    "facilitator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "\u062a\u0633\u0647\u06cc\u0644\u06af\u0631\u0627\u0646"
    },
    "space": {
      "type": "string",
      "title": "\u0641\u0636\u0627\u06cc \u0628\u0631\u06af\u0632\u0627\u0631\u06cc"
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "saturday",
              "sunday",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday"
            ],
            "title": "\u0631\u0648\u0632"
          },
          "start_time": {
            "type": "string",
            "title": "\u0633\u0627\u0639\u062a \u0634\u0631\u0648\u0639"
          },
          "end_time": {
            "type": "string",
            "title": "\u0633\u0627\u0639\u062a \u067e\u0627\u06cc\u0627\u0646"
          }
        }
      },
      "default": [],
      "title": "\u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0641\u062a\u06af\u06cc"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e \u0634\u0631\u0648\u0639"
    },
    "capacity": {
      "type": "number",
      "title": "\u0638\u0631\u0641\u06cc\u062a"
    },
    "facilitator_percentage": {
      "type": "number",
      "title": "\u062f\u0631\u0635\u062f \u062a\u0633\u0647\u06cc\u0644\u06af\u0631"
    },
    "is_ended": {
      "type": "boolean",
      "default": false,
      "title": "\u067e\u0627\u06cc\u0627\u0646 \u06cc\u0627\u0641\u062a\u0647"
    },
    "ended_at": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e \u067e\u0627\u06cc\u0627\u0646"
    }
  },
  "required": [
    "title"
  ]
}