{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "person_name": {
      "type": "string",
      "title": "\u0646\u0627\u0645"
    },
    "person_phone": {
      "type": "string",
      "title": "\u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646"
    },
    "description": {
      "type": "string",
      "title": "\u062a\u0648\u0636\u06cc\u062d\u0627\u062a"
    },
    "amount": {
      "type": "number",
      "title": "\u0645\u0628\u0644\u063a"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "income",
      "title": "\u0646\u0648\u0639 \u062a\u0631\u0627\u06a9\u0646\u0634"
    },
    "category": {
      "type": "string",
      "enum": [
        "workshop",
        "event",
        "cafe",
        "expense"
      ],
      "default": "workshop",
      "title": "\u062f\u0633\u062a\u0647"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "title": "\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062f\u0647"
    },
    "payment_model": {
      "type": "string",
      "enum": [
        "monthly",
        "one_time"
      ],
      "default": "one_time",
      "title": "\u0645\u062f\u0644 \u067e\u0631\u062f\u0627\u062e\u062a\u06cc"
    },
    "related_workshop_id": {
      "type": "string",
      "title": "\u06a9\u0627\u0631\u06af\u0627\u0647 \u0645\u0631\u062a\u0628\u0637"
    }
  },
  "required": [
    "description",
    "amount",
    "type",
    "date"
  ]
}