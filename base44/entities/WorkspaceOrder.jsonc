{
  "name": "WorkspaceOrder",
  "type": "object",
  "properties": {
    "item_type": {
      "type": "string",
      "enum": [
        "daily_chair",
        "monthly_chair"
      ],
      "default": "daily_chair",
      "title": "\u0646\u0648\u0639 \u0635\u0646\u062f\u0644\u06cc"
    },
    "price": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u06cc\u0645\u062a"
    },
    "person_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0645\u0634\u062a\u0631\u06cc"
    },
    "person_phone": {
      "type": "string",
      "title": "\u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "\u062a\u0639\u062f\u0627\u062f"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e \u062e\u0631\u06cc\u062f"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "online",
        "card_to_card",
        "cash",
        "free"
      ],
      "default": "cash",
      "title": "\u0645\u062f\u0644 \u067e\u0631\u062f\u0627\u062e\u062a"
    },
    "entry_time": {
      "type": "string",
      "title": "\u0632\u0645\u0627\u0646 \u0648\u0631\u0648\u062f"
    },
    "usage_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e \u0627\u0633\u062a\u0641\u0627\u062f\u0647"
    },
    "how_met": {
      "type": "string",
      "enum": [
        "instagram",
        "telegram",
        "referral",
        "friends",
        "facilitator",
        "event",
        "introduction",
        "other"
      ],
      "default": "other",
      "title": "\u0646\u062d\u0648\u0647 \u0622\u0634\u0646\u0627\u06cc\u06cc"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "title": "\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062f\u0647"
    }
  },
  "required": [
    "person_phone",
    "purchase_date"
  ]
}