{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u0646\u0627\u0645\u0647"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "saturday",
        "sunday",
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday"
      ],
      "title": "\u0631\u0648\u0632 \u0647\u0641\u062a\u0647"
    },
    "start_time": {
      "type": "string",
      "title": "\u0633\u0627\u0639\u062a \u0634\u0631\u0648\u0639"
    },
    "end_time": {
      "type": "string",
      "title": "\u0633\u0627\u0639\u062a \u067e\u0627\u06cc\u0627\u0646"
    },
    "space": {
      "type": "string",
      "enum": [
        "library",
        "lounge",
        "main"
      ],
      "default": "lounge",
      "title": "\u0641\u0636\u0627"
    },
    "facilitator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "\u062a\u0633\u0647\u06cc\u0644\u06af\u0631\u0647\u0627"
    },
    "sessions_total": {
      "type": "number",
      "title": "\u062a\u0639\u062f\u0627\u062f \u062c\u0644\u0633\u0627\u062a \u06a9\u0644"
    },
    "sessions_remaining": {
      "type": "number",
      "title": "\u062c\u0644\u0633\u0627\u062a \u0628\u0627\u0642\u06cc\u0645\u0627\u0646\u062f\u0647"
    },
    "is_ongoing": {
      "type": "boolean",
      "default": false,
      "title": "\u0627\u062f\u0627\u0645\u0647\u200c\u062f\u0627\u0631"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e \u0634\u0631\u0648\u0639"
    },
    "description": {
      "type": "string",
      "title": "\u062a\u0648\u0636\u06cc\u062d\u0627\u062a"
    }
  },
  "required": [
    "title",
    "day_of_week",
    "start_time",
    "end_time",
    "space"
  ]
}