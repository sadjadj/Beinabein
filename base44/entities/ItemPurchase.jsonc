{
  "name": "ItemPurchase",
  "type": "object",
  "properties": {
    "person_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u06a9\u0627\u0631\u0628\u0631"
    },
    "person_phone": {
      "type": "string",
      "title": "\u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646 \u06a9\u0627\u0631\u0628\u0631"
    },
    "item_name": {
      "type": "string",
      "title": "\u0622\u06cc\u062a\u0645 \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u0634\u062f\u0647"
    },
    "item_price": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u06cc\u0645\u062a \u0622\u06cc\u062a\u0645"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "\u062a\u0639\u062f\u0627\u062f"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "title": "\u062f\u0631\u0635\u062f \u062a\u062e\u0641\u06cc\u0641"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e \u062e\u0631\u06cc\u062f"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "online",
        "card_to_card",
        "cash",
        "free"
      ],
      "default": "cash",
      "title": "\u0645\u062f\u0644 \u067e\u0631\u062f\u0627\u062e\u062a"
    },
    "purchase_reason": {
      "type": "string",
      "enum": [
        "workshop",
        "workspace",
        "event",
        "independent"
      ],
      "default": "independent",
      "title": "\u062f\u0644\u06cc\u0644 \u062e\u0631\u06cc\u062f"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "title": "\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062f\u0647"
    },
    "invoice_id": {
      "type": "string",
      "title": "\u0634\u0646\u0627\u0633\u0647 \u0641\u0627\u06a9\u062a\u0648\u0631"
    }
  },
  "required": [
    "person_phone",
    "item_name",
    "purchase_date"
  ]
}