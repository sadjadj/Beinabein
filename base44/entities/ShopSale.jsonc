{
  "name": "ShopSale",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "store",
        "greenhouse",
        "event"
      ],
      "title": "\u0628\u062e\u0634"
    },
    "event_id": {
      "type": "string",
      "title": "\u0627\u06cc\u0648\u0646\u062a"
    },
    "event_title": {
      "type": "string",
      "title": "\u0646\u0627\u0645 \u0627\u06cc\u0648\u0646\u062a"
    },
    "item_name": {
      "type": "string",
      "title": "\u0646\u0627\u0645 \u0622\u06cc\u062a\u0645"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u06cc\u0645\u062a \u0648\u0627\u062d\u062f"
    },
    "cost_price": {
      "type": "number",
      "default": 0,
      "title": "\u0642\u06cc\u0645\u062a \u062a\u0645\u0627\u0645 \u0634\u062f\u0647"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "\u062a\u0639\u062f\u0627\u062f"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "title": "\u062f\u0631\u0635\u062f \u062a\u062e\u0641\u06cc\u0641"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u06cc\u062e \u0641\u0631\u0648\u0634"
    },
    "buyer_name": {
      "type": "string",
      "title": "\u0646\u0627\u0645 \u062e\u0631\u06cc\u062f\u0627\u0631"
    },
    "buyer_phone": {
      "type": "string",
      "title": "\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633 \u062e\u0631\u06cc\u062f\u0627\u0631"
    },
    "is_paid": {
      "type": "boolean",
      "default": false,
      "title": "\u067e\u0631\u062f\u0627\u062e\u062a \u0634\u062f\u0647"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "online",
        "card_to_card",
        "cash",
        "free",
        "azno"
      ],
      "default": "cash",
      "title": "\u0645\u062f\u0644 \u067e\u0631\u062f\u0627\u062e\u062a"
    },
    "invoice_id": {
      "type": "string",
      "title": "\u0634\u0646\u0627\u0633\u0647 \u0641\u0627\u06a9\u062a\u0648\u0631"
    }
  },
  "required": [
    "section",
    "item_name",
    "quantity",
    "sale_date",
    "buyer_name",
    "buyer_phone"
  ]
}